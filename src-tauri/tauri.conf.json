{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yaminabe-launcher",
  "version": "0.6.0",
  "identifier": "net.reiga7953.yaminabe-launcher.app",
  "build": {
    "beforeDevCommand": {
      "script": "trunk serve",
      "cwd": "../src-ui"
    },
    "beforeBuildCommand": {
      "script": "trunk build",
      "cwd": "../src-ui"
    },
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../src-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Yaminabe Launcher",
        "width": 1600,
        "height": 900,
        "minWidth": 1366,
        "minHeight": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Ign1s-Reiga/yaminabe-launcher/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0NjU5NkE5RTY0MDY5QTAKUldTZ2FVRG1xWlpsZFBodS9UNEJMZ2RmMDVSOXl3ZDdLcy9RcVdiZjYwK0ZUWENkRE1sMHh0blgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
